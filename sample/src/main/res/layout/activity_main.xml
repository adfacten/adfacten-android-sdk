<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button android:id="@+id/btn_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Banner: load" />
            <Button android:id="@+id/btn_interstitial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Interstitial: load + show" />
            <Button android:id="@+id/btn_rewarded" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rewarded: load + show" />
            <Button android:id="@+id/btn_native" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Native: load" />
            <Button android:id="@+id/btn_app_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="App open: load + show" />

            <com.adfacten.ads.NativeAdView
                android:id="@+id/native_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#F2F2F2"
                android:padding="12dp"
                android:visibility="gone"
                app:adf_bodyView="@id/native_body"
                app:adf_brandView="@id/native_brand"
                app:adf_callToActionView="@id/native_cta"
                app:adf_iconView="@id/native_icon"
                app:adf_imageView="@id/native_image"
                app:adf_titleView="@id/native_title">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/native_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/native_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:id="@+id/native_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:id="@+id/native_image" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp" android:scaleType="centerCrop" />
                    <TextView android:id="@+id/native_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <Button android:id="@+id/native_cta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" />
                </LinearLayout>
            </com.adfacten.ads.NativeAdView>

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <com.adfacten.ads.AdfactenBannerView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:adf_adSize="banner" />
</LinearLayout>
